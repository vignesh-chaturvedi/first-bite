# Copy to .env for local development. Next.js, database and worker scripts load it.
# Defaults are a paused preview. Activate only after hosting and campaign setup.
APP_ORIGIN=http://localhost:3000
COOKIE_RPC_URL=https://rpc.cookiescan.io
EXPECTED_GENESIS_HASH=9wDaBRDgArEUpvhHxGguNkwozsZh4UpGZB9o2EoEcBB2
RELAY_ENABLED=false
WORKER_ENABLED=false
PREPARATION_ENABLED=false
TRUSTED_IP_HEADER=none

# Active production requires an HTTPS APP_ORIGIN, DATABASE_URL, matching wrapping
# key and SPONSOR_PUBLIC_KEY on web/worker, and all three enable flags true.
# Only the worker receives SPONSOR_SECRET_KEY_BASE64. Never set it on the web
# service or prefix either private key with NEXT_PUBLIC_. Use a dedicated capped
# sponsor account; do not export the Nightly smoke-test account for this setup.
# SPONSOR_PUBLIC_KEY=<dedicated-app-sponsor-public-address>
# Worker service only; canonical base64 of the 64-byte Solana keypair:
# SPONSOR_SECRET_KEY_BASE64=<worker-secret-manager-value>
# Generate a fresh 32-byte wrapping key locally; never commit it or send it to a browser.
# ATTEMPT_ENCRYPTION_KEY=<canonical-standard-base64-encoded-32-byte-key>
# The database pins the custody identity on first activation. Retain this key
# and its backup; changing it is rejected, not an automatic key rotation.
# Configure x-real-ip or cf-connecting-ip ONLY behind an ingress which overwrites
# that header and prevents direct access. X-Forwarded-For is never trusted here.

# Omit DATABASE_URL for a static preview; an empty value is invalid.
# These are local Compose fixture credentials, never for hosted use.
# DATABASE_URL=postgresql://first_bite:first_bite_local_only@127.0.0.1:55432/first_bite_dev
# DATABASE_TEST_URL=postgresql://first_bite:first_bite_local_only@127.0.0.1:55432/first_bite_test

# Phase 0 and test scripts read exported shell settings, not .env automatically.
WALLET_PROBE_PORT=8787
