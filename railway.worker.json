{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm typecheck"
  },
  "deploy": {
    "startCommand": "node --import tsx src/worker/index.ts",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "overlapSeconds": "10",
    "drainingSeconds": "60"
  }
}
