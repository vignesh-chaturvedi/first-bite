{
  "name": "first-bite",
  "version": "0.0.0",
  "private": true,
  "description": "A capped, invitation-based sponsored .cook onboarding pass",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.6.0 <25"
  },
  "scripts": {
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "test:unit": "vitest run tests/registry.test.ts tests/transaction.test.ts",
    "test:proof": "vitest run tests/registry-proof.test.ts tests/quote-proof.test.ts",
    "phase0:inspect": "node --import tsx scripts/phase0/inspect-chain.ts",
    "phase0:proof": "node --import tsx scripts/phase0/prove-local.ts",
    "phase0:wallet": "node --import tsx scripts/phase0/wallet-probe.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test:db": "vitest run tests/database.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/db/seed.ts",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker/index.ts",
    "test:foundation": "vitest run tests/config.test.ts tests/runtime.test.ts tests/worker.test.ts tests/database.test.ts tests/registry.test.ts tests/transaction.test.ts tests/wallet-probe.test.ts",
    "test:registry": "vitest run tests/registry.test.ts tests/transaction.test.ts tests/chain-client.test.ts tests/transaction-policy.test.ts tests/quote.test.ts tests/quote-mutation.test.ts",
    "phase2:inspect": "node --env-file-if-exists=.env --import tsx scripts/phase2/inspect-registry.ts",
    "test:campaigns": "vitest run tests/security.test.ts tests/campaigns.test.ts tests/campaign-api.test.ts --no-file-parallelism",
    "ops": "node --env-file-if-exists=.env --import tsx scripts/ops/index.ts",
    "test:execution": "vitest run tests/execution-crypto.test.ts tests/execution-chain.test.ts tests/execution-api.test.ts tests/execution-worker.test.ts tests/execution-store.test.ts tests/execution-flow.test.ts tests/settlement.test.ts --no-file-parallelism",
    "phase4:proof": "vitest run tests/execution-flow.test.ts --no-file-parallelism",
    "test:onboarding": "vitest run tests/onboarding-wallet.test.ts tests/onboarding-controller.test.ts tests/onboarding-api.test.ts --no-file-parallelism",
    "test:operations": "vitest run tests/operations-readiness.test.ts tests/operations-accounting.test.ts tests/security-headers.test.ts tests/restore-drill.test.ts tests/operations-export.test.ts --no-file-parallelism",
    "ops:restore-drill": "node --import tsx scripts/ops/restore-drill.ts"
  },
  "dependencies": {
    "@solana/web3.js": "1.99.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "zod": "4.5.4",
    "server-only": "0.0.1",
    "lucide-react": "1.45.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "@radix-ui/react-slot": "1.3.3"
  },
  "devDependencies": {
    "@solana/kit": "8.3.0",
    "@types/node": "24.13.4",
    "litesvm": "1.4.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.28",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "drizzle-kit": "0.31.10",
    "@types/pg": "8.23.1"
  }
}
